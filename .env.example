# Supabase project settings (Project Settings -> API). Copy this file to .env.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Where edition content comes from. Leave unset to use the files in src/content (the default);
# set to "supabase" to serve editions edited in /admin instead. Polls and the G Challenge always
# use Supabase (run supabase/engagement.sql once).
# VITE_CONTENT_SOURCE=supabase

# Public address of the site (no trailing slash). Link previews in Slack, Teams, WhatsApp
# and LinkedIn need it to show the share image.
VITE_SITE_URL=https://journal.example.com
